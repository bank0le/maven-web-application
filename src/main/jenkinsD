pipeline {
    agent any

    tools {
        maven "Maven 3.9.9"
    }

    stages {
        stage('1GetCode') {
            steps {
                sh "echo 'cloning the latest application version'"
                git branch: 'feature',
                    url: 'https://github.com/bank0le/maven-web-application'
            }
        }

        stage('3Test+Build') {
            steps {
                sh "echo 'running JUnit-test-cases'"
                sh "echo 'testing must pass to create artifacts'"
                sh "mvn clean package"
            }
        }

        stage('4CodeQuality') {
    steps {
        sh "echo 'Performing CodeQualityAnalysis'"

        withCredentials([string(
            credentialsId: 'sonar-token',
            variable: 'SONAR_TOKEN'
        )]) {
            sh '''
                echo "SONAR_TOKEN is configured"
                mvn sonar:sonar
            '''
        }
    }
}

        stage('5uploadNexus') {
            steps {
                sh "mvn deploy"
            }
        }
